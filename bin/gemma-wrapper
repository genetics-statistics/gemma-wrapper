USAGE = "
GEMMA wrapper example:

    Simple caching of K computation with

      gemma-wrapper --json -- \
        -g test/data/input/BXD_geno.txt.gz \
        -p test/data/input/BXD_pheno.txt \
        -a test/data/input/BXD_snps.txt \
        -gk > K.json

    LOCO K computation with caching and JSON output

      gemma-wrapper --json --loco -- \
        -g test/data/input/BXD_geno.txt.gz \
        -p test/data/input/BXD_pheno.txt \
        -a test/data/input/BXD_snps.txt \
        -gk -debug > K.json

    LMM's using the K's captured in K.json using the --input switch

      gemma-wrapper --json --lmdb --loco --input K.json -- \
        -g test/data/input/BXD_geno.txt.gz \
        -p test/data/input/BXD_pheno.txt \
        -c test/data/input/BXD_covariates2.txt \
        -a test/data/input/BXD_snps.txt \
        -lmm 9 -maf 0.1 \
        -debug > GWA.json

Gemma gets used from the path. You can override by setting

      env GEMMA_COMMAND=path/bin/gemma gemma-wrapper ...

or by naming the directory that holds the whole GEMMA toolchain -- gemma
itself and the helper programs this wrapper shells out to (time, tar,
parallel) -- once:

      gemma-wrapper --gemma-dir /path/to/bin ...
      env GEMMA_DIR=/path/to/bin gemma-wrapper ...

which is what a container or a Guix profile wants: no PATH surgery, and
no wrapper drifting towards a different gemma than the one next to it.
"
# These are used for testing compatibility with the gemma tool
GEMMA_V_MAJOR = 98
GEMMA_V_MINOR = 4

basepath = File.dirname(File.dirname(__FILE__))
$: << File.join(basepath,'lib')
BIN = File.join(basepath,'bin')

VERSION_FILENAME=File.join(basepath,'VERSION')
version = File.new(VERSION_FILENAME).read.chomp

# ---- GEMMA toolchain directory
#
# The GEMMA toolchain is usually one directory: gemma plus the helpers this
# wrapper shells out to -- GNU time (for the -v stats), tar (for the cache
# archives) and parallel (for LOCO).  Naming that directory once beats a PATH
# that has to be arranged by whoever calls us, and it is what a Guix profile or
# a container has to hand.  Precedence, most explicit first:
#
#   GEMMA_COMMAND (a binary)  >  --gemma-dir / GEMMA_DIR (a directory)  >  PATH
#
# The directory is read from GEMMA_DIR and from a --gemma-dir in ARGV before
# option parsing, because the gemma version banner is printed (and gemma is
# invoked) before OptionParser has run.

def find_tool(name, dirs)
  Array(dirs).compact.each do |dir|
    try_bin = File.join(dir, name)
    return try_bin if File.executable?(try_bin)
  end
  ENV['PATH'].to_s.split(File::PATH_SEPARATOR).each do |dir|
    try_bin = File.join(dir, name)
    return try_bin if File.executable?(try_bin)
  end
  nil
end

gemma_dir = ENV['GEMMA_DIR']
# only our own switches: anything after `--` belongs to gemma
wrapper_argv = ARGV[0...(ARGV.index('--') || ARGV.size)]
wrapper_argv.each_with_index do |arg, i|
  if arg == '--gemma-dir'
    gemma_dir = wrapper_argv[i+1]
  elsif arg.start_with?('--gemma-dir=')
    gemma_dir = arg.split('=',2)[1]
  end
end
# a GEMMA_COMMAND also says where its neighbours are
tool_dirs = [gemma_dir, (File.dirname(ENV['GEMMA_COMMAND']) if ENV['GEMMA_COMMAND'])].compact

gemma_command = ENV['GEMMA_COMMAND'] || find_tool('gemma', tool_dirs)
time_command = find_tool('time', tool_dirs)
tar_command = find_tool('tar', tool_dirs)
parallel_command = find_tool('parallel', tool_dirs)
# `env` is needed by the tar lines that set XZ_OPT; taking it from the same
# directory means the wrapper works with an empty PATH, which is the point of
# naming the toolchain in one place.
env_command = find_tool('env', tool_dirs) || 'env'
# tar compresses through xz, which it finds on PATH, so a toolchain directory
# also goes in front of the PATH those lines run with.  Without this the
# archive step dies as "tar: Child returned status 127" once PATH is empty.
tool_path = lambda { (tool_dirs + [ENV['PATH'].to_s]).reject { |d| d.nil? or d.empty? }.uniq.join(File::PATH_SEPARATOR) }
tar_env = lambda { tool_dirs.empty? ? "#{env_command} XZ_OPT='-T0'" : "#{env_command} XZ_OPT='-T0' PATH=\"#{tool_path.call}\"" }

hashme = nil

require 'digest/sha1'
require 'enumerator'
require 'fileutils'
require 'optparse'
require 'open3'
require 'socket' # for hostname
require 'tempfile'
require 'time'
require 'tmpdir'

require 'lock'

split_at = ARGV.index('--')

if split_at
  gemma_args = ARGV[split_at+1..-1]
end

options = { show_help: false, source: 'https://github.com/genetics-statistics/gemma-wrapper', version: version+' (Pjotr Prins)', date: Time.now.to_s, gemma_command: gemma_command, gemma_dir: gemma_dir, cache_dir: Dir.tmpdir(), quiet: false, phenotypes: nil, phenotype_column: 1, lmdb: nil, parallel: nil, trait: "unknown", name: "test" }

opts = OptionParser.new do |o|
  o.banner = "\nUsage: #{File.basename($0)} [options] -- [gemma-options]"

  o.on('--permutate n', Integer, 'Permutate # times by shuffling phenotypes') do |lst|
    options[:permutate] = lst
    options[:force] = true
  end

  o.on('--phenotypes filen',String, 'Phenotypes as .json, or as .txt to be shuffled in permutations') do |phenotypes|
    # if it is a json file we assume it is of type {"BXD1":54.099998,"BXD2":50.099998,"BXD5":53.299999 ... }
    options[:phenotypes] = phenotypes
    raise "Phenotype input file #{phenotypes} does not exist" if !File.exist?(phenotypes)
  end

  o.on('--phenotype-column n', Integer, 'Get column # GEMMA style (base 1)') do |col|
    options[:phenotype_column] = col
  end

  o.on('--geno-json FILEN','JSON file generated by gn-geno-to-gemma') do |filen|
    options[:geno_json] = filen
    raise "JSON input file #{filen} does not exist" if !File.exist?(filen)
  end

  o.on('--loco', 'Run full leave-one-chromosome-out (LOCO)') do |b|
    options[:loco] = b
  end

  o.on('--meta NAME', 'Pass in metadata as JSON file') do |n|
    options[:meta] = n
  end

  o.on('--population NAME', 'Add population identifier to metadata') do |n|
    options[:population] = n
  end

  o.on('--name NAME', 'Add dataset identifier to metadata') do |n|
    options[:name] = n
  end

  o.on('--id ID', 'Add identifier to metadata') do |n|
    options[:id] = n
  end

  o.on('--trait TRAIT', 'Add trait identifier to metadata') do |n|
    options[:trait] = n
  end

  o.on('--chromosomes [1,2,3]',Array,'Run specific chromosomes') do |lst|
    options[:chromosomes] = lst
  end

  o.on('--input filen',String, 'JSON input variables (used for LOCO control and reduction)') do |filen|
    options[:input] = filen
    raise "JSON input file #{filen} does not exist" if !File.exist?(filen)
  end

  o.on('--gemma-dir DIR',String, 'Directory holding gemma and its helper programs (time, tar, parallel); default $GEMMA_DIR or PATH') do |dir|
    raise "--gemma-dir #{dir} is not a directory" if !File.directory?(dir)
    options[:gemma_dir] = dir
    tool_dirs.unshift(dir) if !tool_dirs.include?(dir)
    gemma_command = find_tool('gemma', tool_dirs)
    options[:gemma_command] = gemma_command
    time_command = find_tool('time', tool_dirs)
    tar_command = find_tool('tar', tool_dirs)
    parallel_command = find_tool('parallel', tool_dirs)
    env_command = find_tool('env', tool_dirs) || 'env'
  end

  o.on('--cache-dir path',String, 'Use a cache directory') do |path|
    options[:cache_dir] = path
  end

  o.on('--json', 'Create output file in JSON format') do |b|
    options[:json] = b
  end

  o.on("--force", "Force computation (override cache)") do |q|
    options[:force] = true
  end

  o.on("--keep", "Keep intermediate files in output") do |q|
    options[:keep] = true
  end

  o.on("--parallel", "Run jobs in parallel") do |b|
    options[:parallel] = true
  end

  o.on("--no-parallel", "Do not run jobs in parallel") do |b|
    options[:parallel] = false
  end

  o.on('--jobs n', Integer, 'Maximum jobs to run in parallel') do |j|
    options[:jobs] = j
  end

  o.on("--lmdb", "Generate lmdb output") do |b|
    options[:lmdb] = true
  end

  o.on("--reduced", "Only store hits in lmdb output") do |b|
    options[:reduced] = true
  end

  o.on("--slurm[=opts]",String,"Use slurm PBS for submitting jobs") do |slurm|
    options[:slurm_opts] = ""
    options[:slurm] = true
    if slurm
      options[:slurm_opts] = slurm
    end
  end

  o.on("--fix-random", "Fixate the randomizer for reproducible testing") do |b|
    srand(12345) # seed randomizer
  end

  o.on("--q", "--quiet", "Run quietly") do |q|
    options[:quiet] = true
  end

  o.on("-v", "--verbose", "Run verbosely") do |v|
    options[:verbose] = true
  end

  o.on("-d", "--debug", "Show debug messages and keep intermediate output") do |v|
    options[:debug] = true
  end

  o.on("--dry-run", "Show commands, but don't execute") do |b|
    options[:dry_run] = b
  end

  o.on('--','Anything after gets passed to GEMMA') do
    o.terminate()
  end

  o.separator ""

  o.on_tail('-h', '--help', 'display this help and exit') do
    options[:show_help] = true
  end
end

opts.parse!(ARGV)

# Help before the version banner: printing the options should not need gemma,
# which matters exactly when the toolchain is what you are trying to point at.
if options[:show_help] or gemma_args == nil
  print opts
  print USAGE
  exit 1
end

# ---- Output handlers
OUTPUT = (options[:json] ? $stderr : $stdout )

record = { warnings: [], errno: 0, debug: [] }
record[:name] = options[:name] if options[:name]
record[:id] = options[:id] if options[:id]
record[:trait] = options[:trait] if options[:trait]
d = DateTime.now
record[:time] = d.strftime("%Y/%m/%d %H:%M")
record[:user] = ENV["USER"]
record[:hostname] = Socket.gethostname

require 'json'

json_out = lambda do
  record.to_json if options[:json]
end

def compute_hash(fn)
  if File.size(fn) > 100_000
    `pfff #{fn}`.split(/\t/)[0]
  else
    Digest::SHA1.hexdigest(File.read(fn))
  end
end

# ---- Some error handlers
error = lambda do |*msg|
  if options[:json]
    record[:error] = *msg.join(" ")
    record[:errno] = 1
    json_out.call
  end
  raise *msg
end

debug = lambda do |*msg|
  if options[:debug]
    record[:debug].push *msg.join("") if options[:json]
    OUTPUT.print "DEBUG: ",*msg,"\n"
  end
end

warning = lambda do |*msg|
  record[:warnings].push *msg.join("")
  OUTPUT.print "WARNING: ",*msg,"\n"
end

info = lambda do |*msg|
  record[:debug].push *msg.join("") if options[:json] and options[:debug]
  OUTPUT.print *msg,"\n" if !options[:quiet]
end

# Fetch chromosomes
def get_chromosomes annofn
  h = {}
  File.open(annofn,"r").each_line do | line |
    chr = line.split(/\s+/)[2]
    h[chr] = true
  end
  h.map { |k,v| k }
end
# ---- Start banner

GEMMA_K_VERSION=version
GEMMA_K_BANNER = "gemma-wrapper #{version} (Ruby #{RUBY_VERSION}) by Pjotr Prins 2017-2024\n"
info.call GEMMA_K_BANNER

# Check gemma version
begin
  gemma_command2 = options[:gemma_command]

  debug.call("Invoke #{gemma_command2}")
  GEMMA_INFO = `#{gemma_command2}`
rescue Errno::ENOENT
  gemma_command2 = "gemma" if not gemma_command2
  error.call "<#{gemma_command2}> command not found"
end

gemma_version_header = GEMMA_INFO.split("\n").grep(/GEMMA|Version/)[0].strip
info.call "Using ",gemma_version_header,"\n"
gemma_version = gemma_version_header.split(/[,\s]+/)[1]
# A drop-in replacement announces its own version first and the GEMMA version it
# is compatible with after it -- "Pangemma 1.0.0 --- GEMMA 0.98.5 compatible" --
# and the version that decides compatibility is the second one.  Without this the
# wrapper compared 1.0.0 against 0.98.4 by taking "1"/"0"/"0" apart, warned that
# GEMMA was out of date on every run, and wrote that warning into the lmdb meta
# record.
if gemma_version_header =~ /GEMMA\s+([0-9]+\.[0-9]+(?:\.[0-9]+)?)/
  gemma_version = $1
end
v_version, v_major, v_minor = gemma_version.split(".")
info.call "Found #{gemma_version}, comparing against expected v0.#{GEMMA_V_MAJOR}.#{GEMMA_V_MINOR}"

info.call gemma_version_header

warning.call "GEMMA version is out of date. Update GEMMA to 0.#{GEMMA_V_MAJOR}.#{GEMMA_V_MINOR}!" if v_major.to_i < GEMMA_V_MAJOR or (v_major.to_i == GEMMA_V_MAJOR and (v_minor != nil and v_minor.to_i < GEMMA_V_MINOR))

options[:gemma_version_header] = gemma_version_header
options[:gemma_version] = gemma_version

if RUBY_VERSION =~ /^1/
  warning "does not run on Ruby 1.x\n"
end

# ---- LOCO defaults to parallel
if options[:parallel] == nil
  options[:parallel] = true if options[:loco]
end

debug.call(options) # some debug output
debug.call(record)

DO_COMPUTE_KINSHIP = gemma_args.include?("-gk")
DO_COMPUTE_GWA = !DO_COMPUTE_KINSHIP

if options[:parallel]
  begin
    skip_cite = `echo "will cite" |#{parallel_command} --citation`
    debug.call(skip_cite)
    PARALLEL_INFO = `#{parallel_command} --help`
  rescue Errno::ENOENT
    error.call "<parallel> command not found (looked in #{tool_dirs.empty? ? 'PATH' : tool_dirs.join(', ')}); --gemma-dir DIR names the toolchain"
  end
  parallel_cmds = []
  if not options[:json]
    error.call "<parallel> needs --json switch"
  end
end

# tar carries the cache archives: without it there is no caching, and the
# failure would otherwise surface as "env: 'tar': No such file or directory"
# from inside a shell.
if tar_command == nil
  error.call "<tar> command not found (looked in #{tool_dirs.empty? ? 'PATH' : tool_dirs.join(', ')}); --gemma-dir DIR names the toolchain"
end

# ---- Genotypes: BIMBAM (-g) or PLINK (-bfile)
#
# LOCO enumerates chromosomes to build one job per chromosome, and GEMMA can only
# leave one out on the BIMBAM path: measured against 0.98.6, `-bfile ... -loco 1'
# and `-loco 2' produce the same K, i.e. -loco is silently ignored, so a wrapper
# that accepted PLINK LOCO would return 20 identical full-data scans and call
# them a LOCO run.  Refuse instead, and say what to convert to.
geno_idx = gemma_args.index '-g'
bfile_idx = gemma_args.index '-bfile'
if geno_idx == nil and bfile_idx == nil
  raise "Expected a GEMMA genotype switch: -g FILE (BIMBAM or .mdb) or -bfile PREFIX"
end
if bfile_idx != nil and geno_idx == nil and options[:loco]
  raise "LOCO needs -g (BIMBAM or an lmdb .mdb store), not -bfile: " +
        "GEMMA 0.98.6 ignores -loco for PLINK input without saying so, so every " +
        "chromosome would get the same full-data K. Convert the genotypes with " +
        "plink --recode A (BIMBAM) or, for pangemma, bin/geno2mdb.py (lmdb)."
end

# ---- Fetch chromosomes from SNP annotation file
#
# Only LOCO needs the list (one job per chromosome), so a plain GWA without -a is
# legitimate -- it used to be refused here before the branch that uses the list
# was reached.
anno_idx = gemma_args.index '-a'
CHROMOSOMES = anno_idx ? get_chromosomes(gemma_args[anno_idx+1]) : []
if options[:loco] and CHROMOSOMES.empty?
  raise "Expected GEMMA -a genotype file switch: LOCO takes the chromosome list " +
        "from the annotation file (rs pos chr), one job per chromosome. " +
        "An lmdb genotype store has the chromosomes in its keys, but the job " +
        "list still comes from here."
end
pheno_idx = gemma_args.index '-p'

# if DO_COMPUTE_GWA and options[:phenotypes]
#   raise "Did not expect GEMMA -p phenotype whith permutations (they are in the JSON file)" if pheno_idx
# end

matches = {
  chr: [:string, /-loco (\S+) /],
  user_time: [:float, /User time \(seconds\): ([\d\.]+)/],
  system_time: [:float, /System time \(seconds\): ([\d\.]+)/],
  perc_cpu: [:int, /Percent of CPU this job got: (\d+)%/],
  wall_clock: [:string, /Elapsed \(wall clock\) time \(h:mm:ss or m:ss\): (\S+)/],
  ram_usage_gb: [:gb, /Maximum resident set size \(kbytes\): (\d+)/],
  command: [:string, /Command being timed: (.+)/]
}

parse_stats = lambda { |buf|
  stats = {}
  buf.split("\\n").each do |s|
    if s =~ /^\t/
      matches.each do |k,v|
        type,m = v
        if s =~ m
          # $stderr.print $1,s
          stats[k] =
            case type
            when :float
              $1.to_f
            when :int
              $1.to_i
            when :gb
              (($1.to_f)/1048576.0).round(3)
            else
              $1
            end
        end
      end
    end
  end
  stats
}

run_stat = {}

# `time -v` is how the per-job stats (wall clock, resident set size) reach the
# JSON.  It is worth having, it is not worth failing over: on a minimal image
# there is no GNU time, and dying with Errno::ENOENT inside Open3.popen_run
# says nothing about what is wrong.  Measured, in a container that had gemma
# and tar but no time.
if time_command == nil
  warning.call "GNU time not found (looked in #{tool_dirs.empty? ? 'PATH' : tool_dirs.join(', ')}): running untimed, no wall clock or RAM stats; --gemma-dir DIR names the toolchain"
end
timed = lambda { |cmd| time_command ? "#{time_command} -v #{cmd}" : cmd }

execute = lambda { |cmd|
  info.call("Executing: #{cmd}")
  err = 0
  stdout_buf = ""
  stderr_buf = ""
  stats = {}
  Open3.popen3(timed.call(cmd)) do |stdin,stdout,stderr,wait_thr|
    stderr_buf = stderr.read
    stdout_buf = stdout.read
    stats = parse_stats.call(stderr_buf)
    stdin.close
    stdout.close
    stderr.close
    err = wait_thr.value
  end
  $stderr.print(stdout_buf)
  $stderr.print(stderr_buf)
  if err and err != 0
    # GEMMA's own complaint, on its own lines and before the backtrace: a Ruby
    # stack trace says where the wrapper gave up, not why GEMMA did. This is the
    # difference between "FATAL ERROR: bailed out with 20" and "unknown option
    # -pve" -- and the caller's error handler can only report what it is given.
    reasons = (stdout_buf+"\n"+stderr_buf).split("\n").map(&:strip).select { |l|
      l =~ /^(ERROR|\*\*\*\*|error!)/ && !l.include?("gemma-wrapper")
    }
    reasons.last(3).each { |l| $stderr.print "gemma: #{l}\n" }
    $stderr.print "FATAL ERROR: gemma-wrapper bailed out with #{err}\n"
    $stderr.print Kernel.caller().join("\n")
    exit 1
  end
  return err,stats
}

compute_hash = lambda do | phenofn = nil |
  # Compute a HASH on the inputs - if it resolves to a file we HASH the file contents
  error.call "Hash is empty" if hashme == nil or hashme == []
  debug.call "Hashing on ",hashme," before phenofn inject"
  hashes = []
  hm = if phenofn
         hashme + ["-p", phenofn]
       else
         hashme
       end
  debug.call("Hashing on ",hm)
  hm.each_with_index do | item, i |
    if i > 0 and hm[i-1] == '-bfile'
      # A PLINK prefix is not a file: the genotypes behind it are three, and
      # hashing the prefix string alone would let a changed .bed reuse the old
      # cache entry.
      ['bed','bim','fam'].each do | ext |
        fn = "#{item}.#{ext}"
        error.call "Missing #{fn} for -bfile #{item}" if not File.file?(fn)
        hashes << compute_hash(fn)
      end
      debug.call [item,hashes.last]
    # if entry is a file use the hash of its content, otherwise just the entry itself
    elsif File.file?(item)
      hashes << compute_hash(item)
      debug.call [item,hashes.last]
    else
      hashes << item
    end
  end
  debug.call(hashes)
  Digest::SHA1.hexdigest hashes.join(' ')
end

error.call "Do not use the GEMMA -o switch!" if gemma_args.include? '-o'
error.call "Do not use the GEMMA -outdir switch!" if gemma_args.include? '-outdir'
GEMMA_ARGS_HASH = gemma_args.dup # do not include outdir

hashme =
  if DO_COMPUTE_KINSHIP and pheno_idx != nil
    # Remove the phenotype file from the hash for GRM computation
    GEMMA_ARGS_HASH[0..pheno_idx-1] + GEMMA_ARGS_HASH[pheno_idx+2..-1]
  else
    GEMMA_ARGS_HASH
  end

HASH = compute_hash.call(options[:phenotypes])
options[:compute_hash_on] = hashme
options[:hash] = HASH

at_exit do
  Lock.release(HASH)
end

Lock.create(HASH) # this will wait for a lock to expire

JOBLOG  = HASH+"-parallel.log"

# Create cache dir
FileUtils::mkdir_p options[:cache_dir]

# tmpdir for GEMMA output - note that if there is an error here it is probably parallel failing!
# if you fail to find the GEMMA error try the --no-parallel --debug switches
Dir.mktmpdir do |tmpdir|
# tmpdir = "/tmp/test" # fixate tmpdir for testing
# FileUtils.rm_rf(tmpdir) if File.exist?(tmpdir)

# Dir.mkdir(tmpdir)

gemma_args << '-outdir'
gemma_args << tmpdir
GEMMA_ARGS = gemma_args

geno_filename = geno_idx != nil ? gemma_args[geno_idx+1] : gemma_args[bfile_idx+1]
geno_hash =
  if geno_idx != nil
    compute_hash(geno_filename)
  else
    # PLINK: the prefix names three files and the .bed holds the genotypes.
    compute_hash(geno_filename+".bed")
  end

debug.call "Options: ",options,"\n" if !options[:quiet]

JOBS =
  if options[:jobs]
    "-j #{options[:jobs]}"
  else
    ""
  end

# Each parallel job is a GEMMA process, and GEMMA's heavy kernels are OpenBLAS
# and OpenMP, so the default is jobs x cores threads on a machine with cores.
# Measured on HLC (427 samples, 260283 SNPs) with a 20-chromosome LOCO at 12
# jobs: 340 s wall and 17434 s of CPU with the default 96 threads per job,
# against 146 s wall and 1634 s of CPU with one thread per job. Even a single
# LMM run is slower with 96 threads than with 8 (69.6 s against 60.0 s), so the
# oversubscription costs wall clock as well as CPU. Give each job one thread
# unless the caller has said otherwise; `OPENBLAS_NUM_THREADS=4 gemma-wrapper`
# still wins, and the single-run case is left alone because 8 threads is
# genuinely faster there than 1.
if options[:parallel]
  # GEMMA uses both OpenBLAS (matrix products) and OpenMP (its own loops), so a
  # cap that sets only one of them is half a cap: whichever the caller names is
  # mirrored onto the other, and the default is one thread each.
  cap = ENV['OPENBLAS_NUM_THREADS'] || ENV['OMP_NUM_THREADS'] || '1'
  if ENV['OPENBLAS_NUM_THREADS'].nil? or ENV['OMP_NUM_THREADS'].nil?
    ENV['OPENBLAS_NUM_THREADS'] ||= cap
    ENV['OMP_NUM_THREADS'] ||= cap
    info.call "Parallel jobs: #{cap} OpenBLAS/OpenMP thread(s) each (set OPENBLAS_NUM_THREADS or OMP_NUM_THREADS to change)"
  end
end

invoke_parallel = lambda do |msg=nil|
  # parallel_cmds = ["echo 1","sleep 1 && echo 2", "false", "echo 3"]
  joblog = tmpdir+"/"+JOBLOG

  File.open(tmpdir+"/parallel-commands.txt","w") do |f|
    cmdfn = f.path
    File.open(cmdfn,"w") do |f|
      parallel_cmds.each do |c|
        f.puts(c)
      end
    end
    parallel_cmds = [] # reset execution list
    cmd = "cat \"#{cmdfn}\""
    debug.call("tmpdir=#{tmpdir}")
    p msg if msg

    if options[:debug]
      # special debug mode to show errors
      err,stats = execute.call("#{parallel_command} #{JOBS} < #{cmdfn}") # first try optimistically to run all jobs in parallel
    else
      err,stats = execute.call("#{parallel_command} #{JOBS} --results #{tmpdir} --joblog #{joblog} < #{cmdfn}") # first try optimistically to run all jobs in parallel
    end
    if err != 0 and not options[:debug]
      [4,1].each do |jobs|
        info.call("Failed to complete parallel run -- retrying with smaller RAM footprint!")
        err,stats = execute.call(cmd+"|#{parallel_command}  -j #{jobs} --results #{tmpdir} --resume --joblog #{joblog}")
        break if err == 0
      end
      if err != 0
        info.call("Parallel run failed!")
        debug.call("Job log is: ",File.read(joblog))
        exit err
      end
    end
  end
  info.call("Parallel run successful!")
end

invoke_gemma = lambda do |extra_args, cache_hit = false, chr = "full", permutation = 1|
  cmd = timed.call("#{gemma_command2} #{extra_args.join(' ')} #{GEMMA_ARGS.join(' ')}")
  record[:gemma_command] = cmd
  return if cache_hit
  if options[:slurm]
    info.call cmd
    hashi = HASH
    prefix = tmpdir+'/'+hashi
    scriptfn  = prefix+".#{chr}.#{permutation}-pbs.sh"
    script = "#!/bin/bash
#SBATCH --job-name=gemma-#{scriptfn}
#SBATCH --ntasks=1
#SBATCH --time=20:00
srun #{cmd}
"
    debug.call(script)
    File.open(scriptfn,"w") { |f|
      f.write(script)
    }
    cmd = "sbatch "+options[:slurm_opts] + scriptfn
  end
  errno =
    if options[:json]
      # capture output
      err = 0
      if options[:dry_run]
        info.call("Would have invoked: ",cmd)
      elsif options[:parallel]
        debug.call("Add parallel job: ",cmd)
        parallel_cmds << cmd
      else
        err,stats = execute.call(cmd)
      end
      err
    else
      if options[:dry_run]
        info.call("Would have invoked ",cmd)
        0
      else
        debug.call("Invoking ",cmd) if options[:debug]
        system(cmd)
        $?.exitstatus
      end
    end
  if errno != 0
    debug.call "Gemma exit ",errno
    record[:errno] = errno
    json_out.call
    raise "exit on GEMMA error #{errno}"
  end
end

create_archive = false

# Takes the hash value and checks whether the (output) file exists
# returns datafn, logfn, cache_hit
cache = lambda do | chr, ext, h=HASH, permutation=0 |
  inject = (chr==nil ? "" : ".#{chr}" )+ext
  hashi = (chr==nil ? h : h+inject)
  prefix = options[:cache_dir]+'/'+hashi # +(permutation!=0 ? ".p"+permutation.to_s : "")
  # for chr 3 and permutation 1 forms something like
  #   /tmp/1b700-a996f.3.cXX.txt.1.log.txt
  logfn  = prefix+".log.txt"
  datafn = prefix+ext
  record[:files] ||= []
  log_basefn = File.basename(logfn)
  data_basefn = File.basename(datafn)
  log_tmpfn = tmpdir+"/"+log_basefn
  data_tmpfn = tmpdir+"/"+data_basefn
  record[:files].push [chr,log_basefn,data_basefn]
  if !options[:force]
    info.call "Checking for #{data_tmpfn}"
    if File.exist? log_tmpfn and File.exist? data_tmpfn
      if File.read(log_tmpfn).include? "total computation time"
        record[:cache_hit] = true
        info.call "#{logfn} CACHE HIT!\n"
        return hashi, true
      end
    end
  end
  return hashi,false
end

# ---- Read JSON input file
json_in = nil
if options[:input]
  begin
    json_in = JSON.parse(File.read(options[:input]))
    record[:input] = json_in
  rescue TypeError, Errno::ENOENT
    abort "ERROR: cannot read JSON input file '#{options[:input]}'. Does it exist?"
  rescue JSON::ParserError => e
    abort "ERROR: '#{options[:input]}' is not valid JSON. Did you forget to pass --json when generating it?\n  (#{e.message.lines.first.chomp})"
  end
end

USE_REDUCED_GRM = (json_in and json_in["input"] and json_in["input"]["samples-reduced"])

# ---- Compute K
kinship = lambda do | chr = nil |
  record[:type] = "K"
  ext = case (GEMMA_ARGS[GEMMA_ARGS.index('-gk')+1]).to_i
        when 0,1 then '.cXX.txt'
        when 2 then '.sXX.txt'
        else error.call "Unknown kinship type"
        end
  # ---- check cache:
  hashi, cache_hit = cache.call chr,ext
  if not cache_hit
    create_archive = true
    if chr != nil
      invoke_gemma.call [ '-loco', chr, '-o', hashi ], cache_hit
    else
      invoke_gemma.call [ '-o', HASH ], cache_hit
    end
  end
end

reduce_samples = lambda do | chr, kfn, pfn |
  if USE_REDUCED_GRM
    # Next we make a reduced GRM and Pheno file
    if pfn
      debug.call "Using existing pheno file! #{pfn}"
    else
      debug.call "Writing pheno file from JSON!"
      reduced_samples = json_in["input"]["samples-reduced"]
      pfn = tmpdir+"/reduced-pheno.txt.tmp"
      debug.call "Writing #{pfn}"
      File.open(pfn,"w") do |f|
        reduced_samples.each do | k,v |
          f.print "#{k}\t#{v}\n"
        end
      end
    end
    debug.call "Reducing GRM! #{kfn}"
    newkfn = tmpdir+"/reduced-GRM-#{chr}.txt.tmp"
    if not File.exist? newkfn # we assume it is identical
      execute.call "python3 #{BIN}/grm-filter.py --json #{options[:input]} --sample-file #{pfn} #{kfn} > #{newkfn}"
    end
    kfn = newkfn
  end
  return kfn,pfn
end

# ---- Run GWA and return list of assoc filenames
gwas = lambda do | chr, kfn, pfn=nil, permutation=0 |
  # if pfn is nil we assume the phenotype file is already on the CLI or in JSON
  record[:type] = "GWA"
  error.call "Do not use the GEMMA -k switch with gemma-wrapper - it is automatic!" if GEMMA_ARGS.include? '-k' # K is automatic
  error.call "Do not use the GEMMA -p switch with gemma-wrapper if you are using --phenotypes! #{GEMMA_ARGS}" if pfn and GEMMA_ARGS.include? '-p'
  kfn,pfn = reduce_samples.call(chr,kfn,pfn)
  # Update hash for each permutation
  hash = compute_hash.call(pfn)
  # The K matrix is an input to GEMMA, but it is not in `hashme': the wrapper
  # appends -k itself (and refuses the caller's), so a rebuilt K used to keep
  # answering from the .assoc.txt computed against the old one.  Measured on
  # BXD.8 (198 strains, lmm 9): 2060 of 21055 rows differed from what the
  # per-chromosome workflow returned, until that GWA cache entry was removed by
  # hand -- the stale K behind it even said 'analyzed individuals = 30' for a
  # 67-sample trait.  Fold the K's own fingerprint into the per-chromosome key.
  # compute_hash already uses pfff above 100KB, which is what keeps hashing a
  # genome-sized GRM affordable (pfff samples the file rather than reading it
  # whole).  Hashing the file GEMMA is actually given also covers
  # reduce_samples' filtered GRM, which changes with the analysed sample set.
  if kfn and File.file?(kfn)
    hash = Digest::SHA1.hexdigest([hash,compute_hash(kfn)].join(' '))
    debug.call [:kfn,kfn,:hash,hash]
  end
  hashi, cache_hit = cache.call(chr,".assoc.txt",hash,permutation)
  if not cache_hit
    create_archive = true
    args = []
    args << [ '-loco', chr ] if chr != nil
    args << [ '-k', kfn, '-o', hashi ]
    args << [ '-p', pfn ] if pfn
    args << [ '-n', '2' ] if USE_REDUCED_GRM # phenotype file is created
    debug.call(args)
    debug.call([:pfn,pfn])
    invoke_gemma.call args,false,chr,permutation
  end
  hashi
end

LOCO = options[:loco]
if LOCO
  if options[:chromosomes]
    CHROMOSOMES = options[:chromosomes]
  end
end

def shuffle_ps(lines,column)
  select = lines.enum_for(:each_with_index).map { |l,i|
    value = l.strip.split(/\t/)[column-1]
    ( value != "NA" ? value : false )
  }
  # print select
  reduced = select.filter { |val| val != false  }
  # print reduced
  shuffled = reduced.shuffle
  # print shuffled
  # plug them back in
  shuf2 = select.map { |v| (v ? shuffled.pop : "NA") }
  # print "\n"
  # print shuf2
  # print shuffled
  # col = reduced.map { |l| l.strip.split(/\t/)[column] }
  # col2 = col.shuffle
  # print(col2)
  # shuffled = select.map { |is_value| (is_value ? col2.pop : "NA")}
  # exit 2
  shuf2
end

if DO_COMPUTE_KINSHIP
  # compute K
  ARCHIVE = options[:cache_dir]+"/"+HASH+"-gemma-cXX.tar.xz"

  if File.exist? ARCHIVE and not options[:force]
    info.call "Unpack archive #{ARCHIVE}!"
    execute.call "#{tar_env.call} #{tar_command} xJf #{ARCHIVE} -C #{tmpdir}"
  end
  info.call CHROMOSOMES
  if LOCO
    CHROMOSOMES.each do |chr|
      info.call "Compute kinship LOCO for chr ",chr
      kinship.call(chr)
    end
  else
    kinship.call # no LOCO
  end
else
  # DO_COMPUTE_GWA
  ARCHIVE =
    if options[:name] and options[:trait]
      options[:cache_dir]+"/"+HASH+"-"+options[:name]+"-"+options[:trait]+"-gemma-GWA.tar.xz"
    else
      options[:cache_dir]+"/"+HASH+"-gemma-GWA.tar.xz"
    end
  if options[:lmdb] and File.exist? ARCHIVE and not options[:force]
    info.call "#{ARCHIVE} CACHE HIT!"
    print json_out.call # short cut because lmdb is self contained, also for LOCO
    exit 0
  end
  # Unconditionally unpack a pre-existing archive into tmpdir, same as
  # the kinship branch above -- without --lmdb there was previously no
  # equivalent step, so gwas' own cache.call below could never find a
  # restored .assoc.txt/.log.txt pair and always recomputed GEMMA, even
  # with a valid cached archive sitting in cache_dir.
  if File.exist? ARCHIVE and not options[:force]
    info.call "Unpack archive #{ARCHIVE}!"
    execute.call "#{tar_env.call} #{tar_command} xJf #{ARCHIVE} -C #{tmpdir}"
  end

  # The LOCO reduction needs the JSON the kinship step wrote (--input). Without
  # it there is nothing to reduce against, and dereferencing json_in here raised
  # "undefined method '[]' for nil" *inside* Dir.mktmpdir -- reported as a Ruby
  # backtrace rather than as the missing input it is. Say so instead.
  if options[:input]
    raise "JSON problem, file #{options[:input]} is not -gk derived" if json_in["type"] != "K"
  elsif LOCO
    raise "LOCO needs the --input JSON the kinship step writes (--json); without it \n" +
          "there is no per-chromosome output to reduce. Re-run with --json --input <kinship.json>."
  end

  trait_values = nil

  if LOCO
    k_files = options[:input] ? json_in["files"].map { |rec| [rec[0],rec[2]] } : []
  end
  if not options[:permutate]
    pfn = options[:phenotypes]
    if pfn =~ /\.json$/
      pheno_json = JSON.parse(File.read(options[:phenotypes]))
      trait_values = pheno_json
      geno = JSON.parse(File.read(options[:geno_json]))

      raise "Geno JSON appears to be wrong" if geno["type"] != "gn-geno-to-gemma"

      pfn = pfn + ".txt"
      File.open(pfn,"w") do |f|
        geno["samples"].each do | ind |
          value = pheno_json[ind]
          value = "NA" if !value
          f.print "#{ind}\t#{value}\n"
        end
      end
    end
    # The GRM this GWA needs is normally inside the K archive, because the K run
    # archived it and removed the .cXX.txt from the cache directory.  Unpack the
    # archive the first time a file is missing, whichever branch asks for it --
    # until this was hoisted out of the LOCO branch, a non-LOCO
    # `--input K.json -- -lmm 2' against --cache-dir passed GEMMA a -k path that
    # did not exist and died with "Enforce failed for file_kin ... open file".
    grm_file = lambda do |kfn|
      path = options[:cache_dir]+"/"+kfn
      if not File.exist?(path) and json_in["archive"]
        archive_grm = options[:cache_dir]+"/"+json_in["archive"]
        if File.exist?(archive_grm)
          info.call "Unpack archive #{archive_grm}!"
          execute.call "#{tar_env.call} #{tar_command} xJf #{archive_grm} -C #{options[:cache_dir]}" # extracts the whole archive
        end
      end
      path
    end
    if LOCO
      k_files.each do | chr, kfn | # call a GWA for each chromosome
        gwas.call(chr,grm_file.call(kfn),pfn)
      end
    else
      # The K is named by the kinship JSON: gwas always passes -k, and the -k
      # switch is refused on the command line, so without --input there is
      # nothing to pass.  Say that, instead of dying on a nil dereference.
      if not options[:input]
        raise "GWA needs the --input JSON a kinship run writes (--json -- -gk), " +
              "because gemma-wrapper names the K file itself and refuses -k on " +
              "the command line. Re-run with --json --input <kinship.json>."
      end
      gwas.call(nil,grm_file.call(json_in["files"][0][2]),pfn)
    end
  else
    # Permute
    ls = nil
    STATS = options[:cache_dir]+"/"+HASH+"-permutation-stats.txt"
    File.open(STATS,"w") do |stats|
      permute_pfn = options[:phenotypes] # can be nil
      if USE_REDUCED_GRM
        permute_pfn = tmpdir+"/reduced-pheno.txt.tmp"
      end
      ps = []
      raise "You should supply --phenotypes with gemma-wrapper --permutate" if not permute_pfn
      File.foreach(permute_pfn).with_index do |line, line_num|
        ps << line
      end
      score_list = []
      significant_str = []
      suggestive_str = []
      column = options[:phenotype_column]
      debug.call(options[:permutate],"x permutations")
      (1..options[:permutate]).each do |permutation|
        info.call("Iteration #{permutation}/#{options[:permutate]}")
        # Create a shuffled phenotype file
        file = File.open(tmpdir+"/phenotypes-#{permutation}","w")
        tmp_pfn = file.path
        shuffle_ps(ps,column).each { |l|
          file.print(l,"\n")
        }
        file.close
        assoc_files = []
        k_files.each do | chr, kfn | # call a GWA for each chromosome
          assoc_files.push gwas.call(chr,"/tmp/"+kfn,tmp_pfn,permutation)
        end
        if options[:parallel]
          invoke_parallel.call([permutation,significant_str,suggestive_str])
        end
        score_min = 1000.0
        location = []
        if not options[:slurm]
          p assoc_files
          assoc_files.each do | assocfn |
            # assocfn = tmpdir + '/' + entry[2]
            debug.call("Reading ",assocfn)
            File.foreach(tmpdir+"/"+assocfn+".assoc.txt").with_index do |assoc, assoc_line_num|
              if assoc_line_num > 0 # skip header
                fields = assoc.strip.split(/\t/)
                p_lrt = fields.last.to_f
                chr,pos,snp = fields
                if p_lrt > 0.0 and p_lrt < score_min
                  score_min = p_lrt
                  location = [chr,pos,snp]
                  p [chr,pos,snp,:min,score_min,:p_lrt,p_lrt,:file,assocfn]
                end
              end
            end
          end
        end
        score_list << score_min
        ls = score_list.sort
        significant = ls[(ls.size - ls.size*0.95).floor]
        suggestive = ls[(ls.size - ls.size*0.67).floor]
        significant_str = ["95 percentile (significant) ",significant,(-Math.log10(significant)).round(1)]
        suggestive_str = ["67 percentile (suggestive)  ",suggestive,(-Math.log10(suggestive)).round(1)]
        p significant_str
        p suggestive_str
        stats.print([permutation,location,significant_str,suggestive_str],"\n")
      end
      stats.print(ls)
    end # stats
    exit 0
  end
end

if options[:parallel]
  invoke_parallel.call()
end

# Collect stats from parallel run

run_stats = {}
$stderr.print "STATS"
Dir.glob(tmpdir+'/*/*' ).each do | dir |
  File.open("#{dir}/stderr") { |f|
    run_stat = parse_stats.call(f.read)
    chr = run_stat[:chr]
    run_stats[chr] = run_stat
  }
end
# Now add up the stats
user_time = 0.0
system_time = 0.0
wall_clock = "0"
ram_usage_gb = 0.0
run_stats.each do | k, v |
  wall_clock=v[:wall_clock] if v[:wall_clock]>wall_clock
  ram_usage_gb += v[:ram_usage_gb]
  user_time += v[:user_time]
  system_time += v[:system_time]
end

record[:user_time] = user_time
record[:system_time] = system_time
record[:wall_clock] = wall_clock
record[:ram_usage_gb] = ram_usage_gb.round(2)
record[:run_stats] = run_stats

if create_archive
  if DO_COMPUTE_GWA
    LMDB = tmpdir+"/"+HASH+'-gemma-GWA.mdb'
    # create lmdb database - we call out into a python script for that.
    # first create a JSON record

    meta =
      if options[:meta]
        { pheno: JSON.parse(File.read(options[:meta])) }
      else
        {}
      end

    meta = meta.merge({
      type: "gemma-wrapper",
      version: version,
      population: options[:population],
      name: options[:name],
      trait: options[:trait],
      geno_filename: geno_filename,
      geno_hash: geno_hash,
      loco: options[:loco],
      url: "https://genenetwork.org/show_trait?trait_id="+options[:trait]+"&dataset="+options[:name],
      archive_GRM: json_in["archive"],
      archive_GWA: File.basename(ARCHIVE)
                      })
    meta[:trait_values] = trait_values if trait_values
    if options[:name] == "BXDPublish"
      meta = meta.merge({
                          table: "PublishData",
                          traitid: options[:trait].to_i,
                          dataid: options[:id].to_i
                        })
    else
      if options[:id] and options[:id] =~ /,/ # this is GN specific
        dataid,probesetid,probesetfreezeid = options[:id].split(",")
        meta[:dataid] = dataid.to_i
        meta[:probesetid] = probesetid.to_i
        meta[:probesetfreezeid] = probesetfreezeid.to_i
      end
    end

    record[:meta] = meta
    metafn = tmpdir+"/"+HASH+"-meta.json"
    File.write(metafn,record.to_json)
    if options[:keep]
      keepdir = tmpdir + "-keep"
      FileUtils.mkdir(keepdir)
      execute.call("cp -vau #{tmpdir}/*.txt #{tmpdir}/*.json #{keepdir}")
    end
    if options[:lmdb]
      File.unlink(LMDB) if File.exist?(LMDB) # removed any cached lmdb
      REDUCED =
        if options[:reduced]
          "--reduced"
        else
          ""
        end
      execute.call "python3 #{BIN}/gemma2lmdb.py --db=#{LMDB} #{REDUCED} --meta=#{metafn} #{tmpdir}/*assoc.txt"
    else
      warning.call "If we don't use the --lmdb switch just copy the files. Old behaviour and should be deprecated."
      execute.call "cp -vau #{tmpdir}/*.txt #{Dir.tmpdir}" # note: don't copy .log files - it confuses parallel
    end
  end
  info.call "Creating archive #{ARCHIVE}..."
  if options[:lmdb]
    execute.call "#{tar_env.call} #{tar_command} -cvJf #{ARCHIVE} #{LMDB} --transform='s,^#{tmpdir[1..-1]}/,,'"
  else
    if DO_COMPUTE_KINSHIP
      # *.log.txt too: the cache lambda above only counts a cache hit
      # when BOTH the data file and its matching .log.txt (containing
      # "total computation time") already exist in tmpdir -- an
      # archive that only ever held the data file could never produce
      # a cache hit once unpacked into a fresh tmpdir on a later run.
      execute.call "#{tar_env.call} #{tar_command} -cvJf #{ARCHIVE} #{tmpdir}/*.cXX.txt #{tmpdir}/*.log.txt --transform='s,^#{tmpdir[1..-1]}/,,'"
    else
      execute.call "#{tar_env.call} #{tar_command} -cvJf #{ARCHIVE} #{tmpdir}/*.assoc.txt #{tmpdir}/*.json #{tmpdir}/*.log.txt --transform='s,^#{tmpdir[1..-1]}/,,'"
    end
    # Leave the per-run logs beside the archive. They are in the .tar.xz
    # already, but reading one out of it means unpacking a multi-megabyte
    # archive to see a few lines -- and those lines are where GEMMA writes its
    # own variance components (`pve estimate`, `se(pve)`, `vg`, `ve`). The
    # files are small and keyed by the same hash as the archive.
    Dir.glob(tmpdir+"/*.log.txt").each do |logfn|
      begin
        FileUtils.cp(logfn, options[:cache_dir]+"/"+File.basename(logfn)) unless File.exist?(options[:cache_dir]+"/"+File.basename(logfn))
      rescue StandardError => e
        debug.call("could not keep #{logfn}: #{e}")
      end
    end
  end
end

end # tmpdir

record[:archive] = File.basename(ARCHIVE)

print json_out.call

# sleep 10_000
